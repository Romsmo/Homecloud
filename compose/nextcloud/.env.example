# Kopieren nach .env und mit echten, starken Werten befuellen.
# NIEMALS diese Datei mit echten Passwoertern committen!

MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PW
MYSQL_PASSWORD=CHANGE_ME_STRONG_DB_PW
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PW
# LAN-IP des Hosts. Dieses Tutorial nutzt keinen Reverse Proxy; falls du spaeter selbst
# einen Reverse Proxy mit eigener Domain vorschaltest (nicht Teil dieses Tutorials),
# ergaenze die Domain hier zusaetzlich (kommagetrennt via mehrere occ-Eintraege, siehe Kapitel 5.5).
NEXTCLOUD_TRUSTED_DOMAIN=192.168.1.20
